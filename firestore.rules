rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin-only settings: prize pot config, uploaded club crests/backgrounds/
    // anthems, and per-award custom sound/GIF overrides. Gated by the
    // username/password screen in the app itself (not Firebase Auth) — so
    // these stay open at the database level. Fine for a small trusted office
    // pool; revisit if this ever needs to hold anything more sensitive.
    match /adminConfig/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /clubAssets/{doc} {
      allow read: if true;
      allow write: if true;
    }
    match /awardMedia/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Reactions on banter awards (🔥/💀/😭): anyone in the office can tap
    // these — but only the three known count fields can ever be touched,
    // nothing arbitrary.
    match /reactions/{doc} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['fire', 'skull', 'cry']);
    }

    // FPL Court case content (defendant/prosecution/defence) — written
    // only by the sync script via the Admin SDK, same as everything else
    // in the catch-all below. No client writes here at all.
    match /fplCourt/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // FPL Court jury votes — anyone can tap Guilty/Not Guilty on the
    // current case. Kept as its OWN document (not merged onto fplCourt's
    // case-content doc above) so this can use the same simple flat-field
    // pattern as `reactions` below: guilty/innocent are the only two
    // fields this doc will ever have, so hasOnly() checking the full
    // resulting document is exactly right here — no dotted field-path
    // merge onto a doc that also has other, unrelated server-owned
    // fields (that combination is what broke the earlier version of this).
    match /fplCourtVotes/{doc} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['guilty', 'innocent']);
    }

    // Each manager's own favourite-club pick (for showing club badges instead
    // of initials in the standings) — written by that person during
    // onboarding, only the one known field can be touched.
    match /managerClubs/{doc} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['club']);
    }

    // Visit log (one doc per manager per day) — written by each person's own
    // browser once per session, so admin can see engagement. Only the known
    // fields can be touched, same pattern as everywhere else.
    match /accessLog/{doc} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['entryId', 'teamName', 'date', 'count']);
    }

    // Everything else (standings, gameweek stats, players, squads) is written
    // only by the sync script via the Admin SDK, which bypasses these rules
    // entirely — so no client writes are allowed here.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
