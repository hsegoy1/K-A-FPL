rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the site link can read the league data.
    // All writes happen only from the sync script via the Admin SDK,
    // which bypasses these rules entirely — so no client writes are allowed.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
